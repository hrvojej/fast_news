{
    "api": {
        "max_retries": 3,
        "timeout": 300,
        "backend": "copilot",
        "default_model": "gpt-5-mini",
        "default_temperature": 0.7,
        "default_top_p": 0.9,
        "default_max_tokens": 16384,
        "fallback_models_copilot": [
            "gpt-5-mini",
            "gpt-5.2",
            "claude-sonnet-4.6",
            "claude-haiku-4.5"
        ],
        "fallback_models_gh": [
            "openai/gpt-4o-mini",
            "openai/gpt-4o",
            "meta/llama-4-scout-17b-16e-instruct",
            "mistral/mistral-small-2503"
        ]
    },
    "summarization": {
        "include_images": true,
        "enable_entity_links": true,
        "enable_featured_image_search": true,
        "char_limit_long_article": 20000,
        "default_summary_length": "long"
    },
    "output": {
        "save_html": true,
        "save_markdown": false,
        "save_text": false
    },
    "database": {
        "batch_size": 10,
        "update_on_success": true
    },
    "rate_limiting": {
        "min_delay": 15.0,
        "max_delay": 17.0,
        "adaptive": true
    }
}
